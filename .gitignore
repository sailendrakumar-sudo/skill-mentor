# ==============================================================================
# Git Ignore Rules for Skill Mentor
# Protects sensitive secrets, API keys, credentials, and build artifacts
# ==============================================================================

# 1. Environment & Secrets (CRITICAL: NEVER commit secrets to GitHub)
.env
.env.*
*.env
*.env.local
*.env.production
*.env.development
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# 2. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
package-lock.json

# 3. Production Builds & Temp Directories
dist/
dist-ssr/
frontend/dist/
build/
*.local
.temp/
supabase/.temp/

# 4. Logs and Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Executables and Tunnels
*.exe
cloudflared.exe
*.dll
*.iso

# 6. IDE & System Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini
