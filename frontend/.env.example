# ==============================================================================
# Skill Mentor Frontend Configuration Template (.env.example)
# Duplicate this file as .env and fill in your actual settings.
# IMPORTANT: DO NOT commit your actual .env file to GitHub.
# ==============================================================================

# Backend API Base Path (Use /api for single-origin unified proxying)
VITE_API_URL=/api

# Supabase Client Configuration (Public Anon Key only, NEVER Service Role Key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
